{
  "rules": {
    "games": {
      "$gameId": {
        ".read": "auth != null && root.child('games/' + $gameId + '/playerUids/' + auth.uid).exists()",
        ".write": "false"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
