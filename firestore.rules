rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin helper functions
    function isAdmin(uid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(uid));
    }

    function isSuperAdmin(uid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(uid)) &&
        get(/databases/$(database)/documents/admins/$(uid)).data.role == 'super_admin';
    }

    function isList(value) {
      return value is list;
    }

    // Users can read any user profile when authenticated, write only their own; admins may write
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null &&
        (request.auth.uid == uid || isAdmin(request.auth.uid));
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Rooms: read any, write only for participants and creator; admins may write
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorUid;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.creatorUid ||
         (isList(resource.data.playerUids) && request.auth.uid in resource.data.playerUids) ||
         // Allow new players to join a waiting room that is not full.
         (resource.data.status == 'waiting' &&
          resource.data.currentPlayerCount < 4 &&
          request.auth.uid in request.resource.data.playerUids &&
          !(request.auth.uid in resource.data.playerUids)) ||
         isAdmin(request.auth.uid));
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.creatorUid || isAdmin(request.auth.uid));
    }

    // Games: read for participants and admins, write by server and admins.
    // The sim_1 document is a public, unauthenticated dev fixture used for
    // emulator smoke tests, so it is explicitly world-readable.
    match /games/{gameId} {
      allow read: if gameId == 'sim_1' ||
        (request.auth != null &&
         (request.auth.uid in resource.data.playerUids || isAdmin(request.auth.uid)));
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Streams: read any, write by host or admin
    match /streams/{streamId} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.uid == resource.data.hostUid || isAdmin(request.auth.uid));
    }

    // Messages: read/write for conversation participants only
    match /messages/{messageId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.senderUid ||
         request.auth.uid == resource.data.receiverUid ||
         isAdmin(request.auth.uid));
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.senderUid;
      allow update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Reports: read/update by admins, create by authenticated users
    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterUid;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.reporterUid || isAdmin(request.auth.uid));
      allow update: if request.auth != null && isAdmin(request.auth.uid);
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Coin transactions: read own and admins, write by admins
    match /coin_transactions/{transactionId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin(request.auth.uid));
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Achievements: read any, write by admin
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Leaderboards: read any, write by admin
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Notifications: read own and admins, create/update by admins, update own (mark read)
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin(request.auth.uid));
      allow create: if request.auth != null && isAdmin(request.auth.uid);
      allow update: if request.auth != null &&
        ((request.auth.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt'])) ||
         isAdmin(request.auth.uid));
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Settings: read any user (needed during pre-auth init for maintenance /
    // feature flags), write by admin only.
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Admins: only admins can read; only super_admin can write
    match /admins/{uid} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow write: if request.auth != null && isSuperAdmin(request.auth.uid);
    }

    // User notifications sub-collection
    match /users/{uid}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    // User game history sub-collection (server-written via Admin SDK, client read-only)
    match /users/{uid}/gameHistory/{historyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User achievements sub-collection (server-written via Admin SDK, client read-only)
    match /users/{uid}/achievements/{achievementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Room chat sub-collection
    // NOTE: Using get() on the room document in a list/read rule breaks query
    // listeners because Firestore cannot evaluate cross-document lookups for
    // list queries. We currently allow any authenticated user to read room chat;
    // tighten this to participants only (e.g. arrayContains on participantUids
    // stored in each message) before shipping to production.
    function isRoomMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId));
      return request.auth != null &&
        room.exists &&
        (request.auth.uid == room.data.creatorUid ||
         (isList(room.data.playerUids) && request.auth.uid in room.data.playerUids));
    }

    match /rooms/{roomId}/chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if isRoomMember(roomId) &&
        request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Per-user conversation metadata (list view)
    match /users/{uid}/conversations/{conversationId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isParticipantInNewMetadata() {
        return request.auth != null &&
          request.resource.data.keys().hasAny(['participantUids']) &&
          request.auth.uid in request.resource.data.participantUids &&
          uid in request.resource.data.participantUids;
      }
      function isParticipantInExistingMetadata() {
        return request.auth != null &&
          resource.data.keys().hasAny(['participantUids']) &&
          request.auth.uid in resource.data.participantUids &&
          uid in resource.data.participantUids;
      }
      allow read, list: if isOwner();
      allow create: if isOwner() || isParticipantInNewMetadata();
      allow update: if isOwner() || isParticipantInExistingMetadata();
      allow delete: if false;
    }

    // Conversations and messages
    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth != null &&
          request.auth.uid in resource.data.participantUids;
      }
      function isParticipantInNew() {
        return request.auth != null &&
          request.auth.uid in request.resource.data.participantUids;
      }
      // get: existing docs require participation; non-existing docs are allowed
      // so the client can check existence before creating a direct conversation.
      allow get: if request.auth != null &&
        (!resource.data.keys().hasAny(['participantUids']) || isParticipant());
      // listing the top-level conversations collection is not supported; use
      // users/{uid}/conversations for the list view.
      allow list: if false;
      allow create: if isParticipantInNew();
      allow update: if isParticipant() &&
        request.auth.uid in request.resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        function conversationParticipant(conversationId) {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId));
          return conv.exists &&
            isList(conv.data.participantUids) &&
            request.auth.uid in conv.data.participantUids;
        }
        allow read: if request.auth != null && conversationParticipant(conversationId);
        allow create: if request.auth != null &&
          conversationParticipant(conversationId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if request.auth != null &&
          conversationParticipant(conversationId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy', 'updatedAt']);
        allow delete: if false;
      }
    }

    // Admin logs: admin read only, write by server
    match /admin_logs/{logId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow write: if false;
    }
  }
}
