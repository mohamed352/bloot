# Firebase Functions environment variables
# Copy this file to .env and fill in real values for local development.
# Do NOT commit .env to version control.

# Agora (used for RTC/RTM token generation)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Super-admin seeding security
# Only this email address is allowed to call seedFirstSuperAdmin when the admins collection is empty.
INITIAL_SUPER_ADMIN_EMAIL=
