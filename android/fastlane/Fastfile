default_platform(:android)

# Firebase App Distribution uploads of large APKs can exceed the Google API
# client's default HTTP send/read timeouts. Extend them before the plugin runs.
require 'google/apis/options'
Google::Apis::ClientOptions.default.send_timeout_sec = 1800  # 30 minutes
Google::Apis::ClientOptions.default.read_timeout_sec = 1800  # 30 minutes
Google::Apis::ClientOptions.default.open_timeout_sec = 300   # 5 minutes

platform :android do
  desc "Submit a new Beta Build to Firebase App Distribution"
  lane :distribute do
    release_notes_file = "release_notes.txt"
    release_notes = File.exist?(release_notes_file) ? File.read(release_notes_file) : "New QA Build"

    # Fastlane runs from android/fastlane, so resolve credentials relative to
    # that directory (two levels up is the project root).
    service_credentials_file = File.expand_path(
      "../../env/bloot-89b2b-firebase-adminsdk-fbsvc-b70047e82d.json"
    )

    apk_path = Dir.chdir("../..") do
      sh("flutter clean")
      sh("flutter build apk --release")
      File.expand_path("build/app/outputs/flutter-apk/app-release.apk")
    end

    firebase_app_distribution(
      app: "1:738592764893:android:e9cf7172926e3a227efc34",
      testers: "mohamedmostafa5830@gmail.com",
      release_notes: release_notes.strip,
      apk_path: apk_path,
      service_credentials_file: service_credentials_file
    )
  end

  desc "Upload an existing APK to Firebase App Distribution without rebuilding"
  lane :upload_only do |options|
    release_notes_file = "release_notes.txt"
    release_notes = File.exist?(release_notes_file) ? File.read(release_notes_file) : "New QA Build"

    service_credentials_file = File.expand_path(
      "../../env/bloot-89b2b-firebase-adminsdk-fbsvc-b70047e82d.json"
    )

    apk_path = options[:apk_path] || File.expand_path(
      "../../build/app/outputs/flutter-apk/app-release.apk"
    )

    unless File.exist?(apk_path)
      UI.user_error!("APK not found at #{apk_path}. Build first or pass apk_path:/path/to.apk")
    end

    firebase_app_distribution(
      app: "1:738592764893:android:e9cf7172926e3a227efc34",
      testers: "mohamedmostafa5830@gmail.com,doaafoaad13@gmail.com",
      release_notes: release_notes.strip,
      apk_path: apk_path,
      service_credentials_file: service_credentials_file
    )
  end
end
